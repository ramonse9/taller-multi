{
  "name": "taller-multi",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Taller Multi",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/taller-api",
    "apps/taller-web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/taller-api",
    "dev:web": "npm run start --workspace=apps/taller-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
