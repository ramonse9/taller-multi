{
  "name": "taller-multi",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Taller Multi",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/taller-api",
    "apps/taller-web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/taller-api",
    "dev:web": "npm run start --workspace=apps/taller-web",
    "db:migrate": "npm run migration:public:run --workspace=apps/taller-api",
    "db:seed": "npm run seed:public --workspace=apps/taller-api",
    "db:bootstrap": "npm run bootstrap --workspace=apps/taller-api",
    "db:verify": "npm run bootstrap:verify --workspace=apps/taller-api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=apps/taller-api",
    "lint": "npm run lint --workspaces --if-present"
  }
}
