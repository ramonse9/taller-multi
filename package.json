{
  "name": "taller-multi",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de Taller Multi",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/taller-api",
    "apps/taller-web",
    "apps/landing"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/taller-api",
    "dev:web": "npm run start --workspace=apps/taller-web",
    "dev:landing": "npm run dev --workspace=apps/landing",
    "build:landing": "npm run build --workspace=apps/landing",
    "preview:landing": "npm run preview --workspace=apps/landing",
    "db:migrate": "npm run migration:public:run --workspace=apps/taller-api",
    "db:seed": "npm run seed:public --workspace=apps/taller-api",
    "db:bootstrap": "npm run bootstrap --workspace=apps/taller-api",
    "db:verify": "npm run bootstrap:verify --workspace=apps/taller-api",
    "db:bootstrap:prod": "npm run db:bootstrap:prod --workspace=apps/taller-api",
    "db:verify:prod": "npm run db:verify:prod --workspace=apps/taller-api",
    "db:reset-v1:prod": "npm run db:reset-v1:prod --workspace=apps/taller-api",
    "config:verify:prod": "npm run config:verify:prod --workspace=apps/taller-api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=apps/taller-api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
