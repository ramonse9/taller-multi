---
import CtaLink from "./CtaLink.astro";
import WhatsAppLink from "./WhatsAppLink.astro";
import { site } from "../config/site";

const navigation = [
  { href: "/#como-funciona", label: "Cómo funciona" },
  { href: "/#control", label: "Control" },
  { href: "/#utilidad", label: "Utilidad" },
  { href: "/#planes", label: "Planes" },
  { href: "/#preguntas", label: "Preguntas" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name}, ir al inicio`}>
      <span class="brand__mark" aria-hidden="true">MS</span>
      <span class="brand__name">
        <strong>Multiservicios</strong>
        <small>24/7</small>
      </span>
    </a>

    <nav class="desktop-navigation" aria-label="Navegación principal">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <CtaLink href={site.appUrl} variant="quiet">Entrar</CtaLink>
      <WhatsAppLink
        placement="header_desktop"
        variant="primary"
        label={`Solicitar demostración por WhatsApp al ${site.whatsappDisplay}`}
      >
        Solicitar demostración
      </WhatsAppLink>
    </div>

    <details class="mobile-navigation">
      <summary aria-label="Abrir navegación">Menú</summary>
      <nav aria-label="Navegación móvil">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={site.appUrl}>Entrar a la plataforma</a>
        <WhatsAppLink placement="header_mobile_menu" variant="plain">
          Solicitar demostración
        </WhatsAppLink>
      </nav>
    </details>
  </div>
</header>
