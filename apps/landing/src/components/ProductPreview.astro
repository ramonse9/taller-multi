<aside class="product-frame" aria-label="Vista ilustrativa del tablero y una orden de servicio">
  <div class="product-frame__topbar">
    <span class="product-frame__brand">MS 24/7</span>
    <span class="product-frame__label">Vista ilustrativa · sin datos reales</span>
  </div>

  <div class="product-preview">
    <div class="product-preview__metrics" aria-label="Indicadores disponibles en el tablero">
      <div><small>ÓRDENES</small><strong>En proceso</strong></div>
      <div><small>COBRO</small><strong>Pendiente</strong></div>
      <div><small>RESULTADO</small><strong>Utilidad</strong></div>
    </div>

    <div class="product-preview__order">
      <div class="product-preview__heading">
        <div><small>ORDEN DE SERVICIO</small><strong>Cliente, vehículo y trabajo</strong></div>
        <span class="status status--progress">En proceso</span>
      </div>
      <div class="product-preview__line">
        <span class="product-preview__symbol product-preview__symbol--service" aria-hidden="true">S</span>
        <div><strong>Servicio cobrable</strong><small>Forma parte del total de la orden</small></div>
      </div>
      <div class="product-preview__line">
        <span class="product-preview__symbol product-preview__symbol--supply" aria-hidden="true">I</span>
        <div><strong>Insumo utilizado</strong><small>Se considera en el costo y la utilidad</small></div>
      </div>
      <div class="product-preview__result">
        <span>Ingresos cobrables</span><span>− costos directos</span><strong>= utilidad bruta</strong>
      </div>
    </div>
  </div>
</aside>
