---
import { site } from "../config/site";
import WhatsAppLink from "./WhatsAppLink.astro";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <a class="brand brand--footer" href="/" aria-label={`${site.name}, ir al inicio`}>
        <span class="brand__mark" aria-hidden="true">MS</span>
        <span class="brand__name">
          <strong>Multiservicios</strong>
          <small>24/7</small>
        </span>
      </a>
      <p class="site-footer__summary">
        Software para organizar la operación y el control de talleres automotrices.
      </p>
    </div>

    <div>
      <p class="site-footer__title">Producto</p>
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#control">Control</a>
      <a href="/#utilidad">Utilidad</a>
      <a href="/#planes">Planes</a>
      <a href="/#preguntas">Preguntas frecuentes</a>
    </div>

    <div>
      <p class="site-footer__title">Contacto</p>
      <WhatsAppLink placement="footer" variant="plain">
        WhatsApp {site.whatsappDisplay}
      </WhatsAppLink>
      {site.contactEmail && (
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      )}
      <a href={site.appUrl}>Entrar a la plataforma</a>
      <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
    </div>
  </div>
  <div class="container site-footer__legal">
    <span>© {currentYear} {site.name}</span>
    <span>Hecho para talleres automotrices en México.</span>
  </div>
</footer>
