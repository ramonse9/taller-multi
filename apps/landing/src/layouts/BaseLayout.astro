---
import "../styles/global.css";
import { site } from "../config/site";
import WhatsAppLink from "../components/WhatsAppLink.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = "/",
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, site.url);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14263c" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <WhatsAppLink
      placement="mobile_floating"
      variant="plain"
      class="whatsapp-mobile-action"
      label={`Solicitar demostración por WhatsApp al ${site.whatsappDisplay}`}
    >
      <span aria-hidden="true">WA</span>
      WhatsApp
    </WhatsAppLink>
    <script>
      import "../scripts/conversion";
    </script>
  </body>
</html>
