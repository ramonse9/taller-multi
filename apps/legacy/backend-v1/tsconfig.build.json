{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "noEmitOnError": false
  },
  "include": ["src/**/*"],  
  "exclude": [
    "node_modules",
    "test",
    "**/*spec.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__mocks__/**",
    "dist"
  ]
}
