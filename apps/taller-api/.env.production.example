# Render establece PORT automáticamente para el Web Service.
NODE_ENV=production
PORT=10000

# Conserva la Internal Database URL del PostgreSQL actual de Render.
DATABASE_URL=postgresql://user:password@internal-host/database
DATABASE_SSL=false

# Origen exacto del frontend, sin diagonal final ni rutas.
CORS_ORIGINS=https://app.multiservicios247.com

JWT_ISSUER=taller-api
JWT_AUDIENCE=taller-web
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

AUTH_REFRESH_COOKIE_NAME=__Host-taller_refresh_token
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_PATH=/
# Debe permanecer vacío para una cookie __Host- limitada a api.multiservicios247.com.
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REQUIRE_TRUSTED_ORIGIN=true

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SENSITIVE_RATE_LIMIT_TTL_MS=60000
SENSITIVE_RATE_LIMIT_MAX=3
TRUST_PROXY_HOPS=1

# Sólo son necesarias para crear el primer administrador en una base vacía.
# Después de verificar su acceso pueden retirarse del entorno.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-initial-password
