{
  "name": "taller-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend multi-tenant para taller, con un schema PostgreSQL por compañía",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md,yml}\"",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:public:run": "typeorm-ts-node-commonjs migration:run -d src/database/public-data-source.ts",
    "migration:public:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/public-data-source.ts",
    "seed:public": "ts-node -r tsconfig-paths/register src/database/seeds/run-public-seed.ts",
    "bootstrap": "ts-node -r tsconfig-paths/register src/database/bootstrap.ts",
    "bootstrap:verify": "ts-node -r tsconfig-paths/register src/database/verify-bootstrap.ts",
    "db:bootstrap:prod": "node dist/database/bootstrap.js",
    "db:verify:prod": "node dist/database/verify-bootstrap.js",
    "db:reset-v1:prod": "node dist/database/reset-v1-to-v2.js",
    "config:verify:prod": "node dist/config/verify-production-environment.js",
    "platform-admin:password": "ts-node -r tsconfig-paths/register src/platform-users/change-platform-admin-password.ts --environment=local",
    "platform-admin:password:local": "ts-node -r tsconfig-paths/register src/platform-users/change-platform-admin-password.ts --environment=local",
    "platform-admin:password:prod": "node dist/platform-users/change-platform-admin-password.js --environment=production"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.module.ts",
      "!src/main.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
