NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taller_app:change_me@127.0.0.1:5432/taller_multi_dev
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
JWT_ISSUER=taller-api
JWT_AUDIENCE=taller-clients
JWT_ACCESS_SECRET=replace-with-a-different-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
AUTH_REFRESH_COOKIE_NAME=taller_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_PATH=/api/auth
# Déjalo vacío para crear una cookie limitada al host que responde.
AUTH_REFRESH_COOKIE_DOMAIN=
# En producción debe ser true: exige Origin/Referer permitido en login, refresh y logout.
AUTH_REQUIRE_TRUSTED_ORIGIN=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
SENSITIVE_RATE_LIMIT_TTL_MS=60000
SENSITIVE_RATE_LIMIT_MAX=3
# Número de proxies confiables delante de la API. Usa 0 cuando se accede directamente.
TRUST_PROXY_HOPS=0
BOOTSTRAP_ADMIN_EMAIL=admin@taller.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
