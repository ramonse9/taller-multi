# Dependencies
**/node_modules/

# Build and test output
**/dist/
**/coverage/
**/out-tsc/
**/.angular/
**/.cache/
**/*.tsbuildinfo

# Environment files and local secrets
**/.env
**/.env.*
!**/.env.example

# Local certificates and private keys
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx

# Local migration backups (not part of the monorepo)
.local-backups/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Editors and operating systems
**/.DS_Store
**/.idea/
**/.vscode/
**/*~

# Temporary files
**/.tmp/
**/tmp/
**/*.swp
**/*.swo
